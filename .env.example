# Copy to .env and adjust. Never commit real secrets. Variable reference: ENVIRONMENT_STATUS.md
# `make api-dev` reads DATABASE_URL below; the compose containers build their own from POSTGRES_*.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://retailops:retailops@localhost:54329/retailops
LOG_LEVEL=INFO
# Keep false unless an edge proxy in front of the web app appends the client address to
# X-Forwarded-For and the API is unreachable from outside (SECURITY.md §5).
TRUST_PROXY_HEADERS=false

# Required in production: a long random value (`openssl rand -hex 32`, at least 32 characters)
SESSION_SECRET=change-me
COOKIE_SECURE=false

DEMO_MODE_ENABLED=true
# Local/test only: password for the seeded staff accounts (`make seed`, compose demo-seed).
# Refused when APP_ENV=production.
DEMO_STAFF_PASSWORD=

# AI copilot uses free-tier providers only. "deterministic" works without any key and is the
# automatic fallback when a live provider is rate-limited (HTTP 429), slow, or unavailable.
#   gemini            -> free API key from Google AI Studio (GEMINI_API_KEY)
#   openai_compatible -> any OpenAI-compatible free tier, e.g. Groq or OpenRouter free models
LLM_PROVIDER=deterministic
GEMINI_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
COPILOT_RATE_LIMIT_PER_MINUTE=20

# Local docker compose
POSTGRES_USER=retailops
POSTGRES_PASSWORD=retailops
POSTGRES_DB=retailops
POSTGRES_HOST_PORT=54329
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Web (Next.js): where `/api/*` is proxied. Read at build time. Local default: http://localhost:8000
# The web container image takes it as a build argument (compose: http://api:8000).
API_INTERNAL_URL=http://localhost:8000
